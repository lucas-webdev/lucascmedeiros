# Copie para .env (ignorado pelo Git). Nunca coloque o TOKEN aqui: ele fica
# nas Script Properties do Apps Script e no localStorage do app.

# URL /exec da implantação do Apps Script (lida pelo frontend no build)
NEXT_PUBLIC_DESPESAS_API=https://script.google.com/macros/s/XXXXXXXX/exec

# ID da implantação (usado por `npm run despesas:api:deploy`)
DESPESAS_DEPLOYMENT_ID=XXXXXXXX
